# ═══════════════════════════════════════════════════════════════
# Multi-stage Dockerfile for Analysis Service
# ═══════════════════════════════════════════════════════════════

# Stage 1: Build
FROM rust:1.85-bookworm AS builder

WORKDIR /app

# Install dependencies (including tree-sitter build deps)
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY packages ./packages
COPY proto ./proto

# Build release binary
RUN cargo build --release --bin analysis

# ═══════════════════════════════════════════════════════════════
# Stage 2: Runtime
# ═══════════════════════════════════════════════════════════════
FROM debian:bookworm-slim AS runtime

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid 1000 --shell /bin/bash --create-home appuser

# Copy binary from builder
COPY --from=builder /app/target/release/analysis /usr/local/bin/analysis

# Set ownership
RUN chown -R appuser:appuser /app

USER appuser

# Expose metrics port
EXPOSE 9091

# Run the binary
CMD ["analysis"]
