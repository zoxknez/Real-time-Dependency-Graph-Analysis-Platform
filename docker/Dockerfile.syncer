# ============================================================================
# Syncer Service Dockerfile
# ============================================================================
# Multi-stage build for minimal production image
# Bridge between RisingWave streaming SQL and storage layer (Memgraph/Qdrant)

# Stage 1: Build
FROM rust:1.85-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    cmake \
    protobuf-compiler \
    libprotobuf-dev \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY packages ./packages
COPY proto ./proto

# Build in release mode
RUN cargo build --release --bin syncer

# Stage 2: Runtime
FROM debian:bookworm-slim AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -r -s /bin/false syncer

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/syncer /app/syncer

# Set ownership
RUN chown -R syncer:syncer /app

USER syncer

# Default environment variables
ENV RUST_LOG=info
ENV RISINGWAVE_URL=postgres://root@risingwave:4566/dev
ENV MEMGRAPH_URL=bolt://memgraph:7687
ENV QDRANT_URL=http://qdrant:6334

EXPOSE 9093

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9093/health/ready || exit 1

# Run the service
ENTRYPOINT ["/app/syncer"]
