# Build stage
FROM rust:1.75-bookworm AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY packages packages
COPY apps apps

# Build release binary
RUN cargo build --release -p analysis

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy binary
COPY --from=builder /app/target/release/analysis /app/analysis

# Create models directory
RUN mkdir -p /models

# Create non-root user
RUN groupadd -r idp && useradd -r -g idp idp
RUN chown -R idp:idp /app /models
USER idp

# Run
CMD ["/app/analysis"]
