# Multi-stage build for Analysis Service
# Based on Rust best practices: https://docs.docker.com/language/rust/build-images/

# ═══════════════════════════════════════════════════════════════
# Stage 1: Builder
# ═══════════════════════════════════════════════════════════════
FROM rust:1.85-bookworm as builder

# Install protobuf compiler
RUN apt-get update && apt-get install -y \
    protobuf-compiler \
    libprotobuf-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifests
COPY Cargo.toml Cargo.lock ./
COPY packages/ packages/
COPY apps/analysis/ apps/analysis/
COPY proto/ proto/

# Build dependencies (cached layer)
RUN cargo build --release --bin analysis

# ═══════════════════════════════════════════════════════════════
# Stage 2: Runtime
# ═══════════════════════════════════════════════════════════════
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -u 1000 -s /bin/bash appuser

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/analysis /usr/local/bin/analysis

# Create directories for models and temp files
RUN mkdir -p /models /tmp && \
    chown -R appuser:appuser /app /models /tmp

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:9091/health/ready || exit 1

# Expose metrics port
EXPOSE 9091

# Run the binary
CMD ["analysis"]
