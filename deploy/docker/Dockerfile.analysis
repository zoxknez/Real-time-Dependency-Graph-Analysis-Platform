# Build stage
FROM rustlang/rust:nightly-bookworm AS builder

WORKDIR /app

ENV CARGO_HTTP_TIMEOUT=600 \
    CARGO_NET_RETRY=10

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY packages packages
COPY apps apps
COPY tests tests

# Build release binary
RUN cargo build --release -p analysis

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy binary

# Copy binary
COPY --from=builder /app/target/release/analysis /app/analysis

# Create models directory
RUN mkdir -p /models

# Create non-root user
RUN groupadd -r idp && useradd -r -g idp idp
RUN chown -R idp:idp /app /models
USER idp

EXPOSE 9091

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:9091/health/ready || exit 1

# Run
CMD ["/app/analysis"]
