# syntax=docker/dockerfile:1.7

# Multi-stage build for Next.js Frontend
# Based on Next.js Docker best practices: https://nextjs.org/docs/deployment#docker-image

# Stage 1: Dependencies
FROM node:22-alpine AS deps

ENV NPM_CONFIG_FETCH_RETRIES=5 \
    NPM_CONFIG_FETCH_RETRY_FACTOR=2 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000 \
    NPM_CONFIG_FETCH_TIMEOUT=600000

# Install libc6-compat for Alpine compatibility
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy package files
COPY apps/frontend/package.json apps/frontend/package-lock.json* ./

# Install dependencies required for the build. The runner stage copies only the
# standalone output, so dev dependencies do not ship in the final image.
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline --no-audit --fund=false

# Stage 2: Builder
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy application code
COPY apps/frontend/ ./

# Build arguments for environment variables
ARG NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:8000/graphql
ARG NEXT_PUBLIC_WS_ENDPOINT=ws://localhost:8000/graphql/ws
ARG NEXT_PUBLIC_AGENT_STREAM_ENDPOINT=http://localhost:8000/agent/stream
ARG NEXT_PUBLIC_SEARCH_MODE=semantic

# Set environment variables for build
ENV NEXT_PUBLIC_GRAPHQL_ENDPOINT=$NEXT_PUBLIC_GRAPHQL_ENDPOINT
ENV NEXT_PUBLIC_WS_ENDPOINT=$NEXT_PUBLIC_WS_ENDPOINT
ENV NEXT_PUBLIC_AGENT_STREAM_ENDPOINT=$NEXT_PUBLIC_AGENT_STREAM_ENDPOINT
ENV NEXT_PUBLIC_SEARCH_MODE=$NEXT_PUBLIC_SEARCH_MODE
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build Next.js application
RUN npm run build

# Stage 3: Runner
FROM node:22-alpine AS runner

WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy necessary files from builder
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Set ownership
RUN chown -R nextjs:nodejs /app

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD node -e "require('http').get('http://127.0.0.1:3000', r => process.exit(r.statusCode >= 200 && r.statusCode < 400 ? 0 : 1)).on('error', () => process.exit(1))"

# Start the application
CMD ["node", "server.js"]
