# Build stage
FROM node:20-alpine AS builder

WORKDIR /tmp/app

# Avoid permission errors writing npm cache
ENV NPM_CONFIG_CACHE=/tmp/.npm

# Copy package files
COPY apps/frontend/package.json ./
COPY apps/frontend/package-lock.json* ./

# Install dependencies (including devDeps needed for Next.js build)
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# Copy source (excluding node_modules via .dockerignore)
COPY apps/frontend/src ./src
COPY apps/frontend/public ./public
COPY apps/frontend/next.config.js ./
COPY apps/frontend/tailwind.config.ts ./
COPY apps/frontend/postcss.config.js ./
COPY apps/frontend/tsconfig.json ./
COPY apps/frontend/next-env.d.ts ./

# Public env (must be set at build time for Next.js client bundles)
# Provide safe defaults so CI builds don't produce empty endpoints.
ARG NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:8000/graphql
ARG NEXT_PUBLIC_WS_ENDPOINT=ws://localhost:8000/graphql/ws
ARG NEXT_PUBLIC_AGENT_STREAM_ENDPOINT=http://localhost:8000/agent/stream
ARG NEXT_PUBLIC_SEARCH_MODE=name

ENV NEXT_PUBLIC_GRAPHQL_ENDPOINT=$NEXT_PUBLIC_GRAPHQL_ENDPOINT
ENV NEXT_PUBLIC_WS_ENDPOINT=$NEXT_PUBLIC_WS_ENDPOINT
ENV NEXT_PUBLIC_AGENT_STREAM_ENDPOINT=$NEXT_PUBLIC_AGENT_STREAM_ENDPOINT
ENV NEXT_PUBLIC_SEARCH_MODE=$NEXT_PUBLIC_SEARCH_MODE

# Build
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# Runtime stage
FROM node:20-alpine

WORKDIR /app

# Avoid permission errors writing npm cache
ENV NPM_CONFIG_CACHE=/tmp/.npm

# Copy built app into a subdir to avoid node_modules path conflicts
COPY --from=builder /tmp/app/.next/standalone ./standalone
COPY --from=builder /tmp/app/.next/static ./standalone/.next/static
COPY --from=builder /tmp/app/public ./standalone/public

WORKDIR /app/standalone

# Use built-in non-root user from base image
USER node

# Expose port
EXPOSE 3000

# Environment
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Run
CMD ["node", "server.js"]
