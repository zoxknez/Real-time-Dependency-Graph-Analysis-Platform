# syntax=docker/dockerfile:1.7

# Build stage
FROM rust:1.98.0-slim-bookworm AS builder

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HTTP_TIMEOUT=600 \
    CARGO_NET_RETRY=10

RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    libcurl4-openssl-dev \
    cmake \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY packages packages
COPY apps apps
COPY proto proto
COPY tests tests

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --profile docker -p ingestion

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/docker/ingestion /app/ingestion

RUN groupadd -r idp && useradd -r -g idp idp
USER idp

EXPOSE 9001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:9001/health/ready || exit 1

CMD ["/app/ingestion"]
