# Build stage
FROM rustlang/rust:nightly-bookworm AS builder

WORKDIR /app

ENV CARGO_HTTP_TIMEOUT=600 \
    CARGO_NET_RETRY=10

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY packages packages
COPY apps apps
COPY tests tests

RUN cargo build --release -p vector-writer

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/vector-writer /app/vector-writer

RUN groupadd -r idp && useradd -r -g idp idp
USER idp

EXPOSE 9092

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:9092/health/ready || exit 1

CMD ["/app/vector-writer"]
