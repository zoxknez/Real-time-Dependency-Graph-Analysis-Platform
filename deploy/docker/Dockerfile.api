# syntax=docker/dockerfile:1.7

# Build stage
# Rust 1.92 supports edition 2024, so nightly is unnecessary here and much
# heavier for local Docker Desktop builds.
FROM rust:1.92-slim-bookworm AS builder

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_NET_RETRY=10 \
    CARGO_HTTP_TIMEOUT=600 \
    CARGO_TERM_COLOR=never

# Install build dependencies.
# - protobuf-compiler is required for crates using tonic_build/prost_build.
# - libcurl4-openssl-dev is required by rdkafka-sys when building librdkafka.
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    libcurl4-openssl-dev \
    cmake \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Copy the full source and build only the API package.
COPY Cargo.toml Cargo.lock ./
COPY packages packages
COPY apps apps
COPY proto proto
COPY tests tests

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --profile docker -p api

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy binary
COPY --from=builder /app/target/docker/api /app/api

# Create non-root user
RUN groupadd -r idp && useradd -r -g idp idp
USER idp

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run
CMD ["/app/api"]
