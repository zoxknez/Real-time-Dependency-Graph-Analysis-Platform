# ═══════════════════════════════════════════════════════════════
# INVERSE DEPENDENCIES PLATFORM - Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Kafka/Redpanda
KAFKA_BROKERS=localhost:19092
KAFKA_INGESTION_TOPIC=ingestion-events
KAFKA_ANALYSIS_TOPIC=analysis-events

# Memgraph
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# Qdrant
QDRANT_URL=http://localhost:6333

# RisingWave
RISINGWAVE_URL=postgres://root@localhost:4566/dev

# Redis
REDIS_URL=redis://localhost:6379

# API
API_HOST=0.0.0.0
API_PORT=8080
JWT_SECRET=your-secret-key-change-in-production

# Logging
RUST_LOG=info
