# ═══════════════════════════════════════════════════════════════
# DEPENDENCY GRAPH SECURITY PLATFORM - Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Kafka/Redpanda
KAFKA_BROKERS=localhost:19092
KAFKA_INGESTION_TOPIC=ingestion-events
KAFKA_ANALYSIS_TOPIC=analysis-events

# Memgraph
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# Qdrant
QDRANT_URL=http://localhost:6334

# RisingWave
RISINGWAVE_URL=postgres://root@localhost:4566/dev

# Redis
REDIS_URL=redis://localhost:6379

# API
API_HOST=0.0.0.0
API_PORT=4001
JWT_SECRET=your-secret-key-change-in-production

# Logging
RUST_LOG=info

DATABASE_URL=postgres://idp:idp_secret@localhost:5432/inverse_deps

# Gemini 3 API (Get your key at https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_FLASH_MODEL=gemini-3-flash-preview
GEMINI_THINKING_MODEL=gemini-3-pro-preview
GEMINI_LIVE_EPHEMERAL_TOKEN=

ANALYSIS__EMBEDDING__PROVIDER=mock
