# GraphQL API endpoint
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:8000/graphql

# WebSocket endpoint for subscriptions (optional)
NEXT_PUBLIC_WS_ENDPOINT=ws://localhost:8000/graphql

# App configuration
NEXT_PUBLIC_APP_NAME=Inverse Dependency Platform
NEXT_PUBLIC_APP_VERSION=0.1.0

# Search mode: "name" (default) or "semantic"
# When set to semantic, Explore uses semanticSearchPackages (Qdrant-backed)
NEXT_PUBLIC_SEARCH_MODE=name
